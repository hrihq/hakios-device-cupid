--- a/BootShim/BootShim.S
+++ b/BootShim/BootShim.S
@@ -17,6 +17,44 @@
 #endif
 
 _Start:
+#ifdef CUPID_SHIM_BEACON
+  /*
+   * Cupid bring-up test, before the FD is copied.
+   *   screen: paint the ABL splash buffer (Display Reserved 0xB8000000) -> the panel is
+   *           still scanned out and our code is running.
+   *   CUPID_SHIM_HOLD: stay here, so the colour left on the panel is the proof.
+   *   otherwise: write IMEM restart_reason 0x77665500 at 0x146AA65C and ask PSCI to reset.
+   */
+  ldr   x7, =0xB8000000
+  ldr   x8, =(1080 * 2400)
+  movz  w9, #0x00ff
+  movk  w9, #0xff00, lsl #16
+_CupidFb:
+  str   w9, [x7], #4
+  subs  x8, x8, #1
+  b.ne  _CupidFb
+  dsb   sy
+#ifdef CUPID_SHIM_HOLD
+_CupidSpin:
+  wfe
+  b     _CupidSpin
+#endif
+  movz  x7, #0xa65c
+  movk  x7, #0x146a, lsl #16
+  movz  w3, #0x5500
+  movk  w3, #0x7766, lsl #16
+  str   w3, [x7]
+  dsb   sy
+  movz  x0, #0x0009
+  movk  x0, #0x8400, lsl #16
+  mov   x1, xzr
+  mov   x2, xzr
+  mov   x3, xzr
+  smc   #0
+_CupidHold:
+  wfe
+  b     _CupidHold
+#endif
   mov   x4, x1
   ldr   x5, =FD_BASE
   cmp   x4, x5
@@ -50,6 +88,30 @@
 _NoPayload:
 #endif
   ldr   x5, =FD_BASE
+#ifdef CUPID_SHIM_STAGE2
+  /*
+   * The FD and the payload have been copied. Paint green, wait three seconds, then hand over:
+   * green that stays means the FD never took control; green that goes away means it did.
+   */
+  ldr   x7, =0xB8000000
+  ldr   x8, =(1080 * 2400)
+  movz  w9, #0xff00
+  movk  w9, #0xff00, lsl #16
+_CupidGreen:
+  str   w9, [x7], #4
+  subs  x8, x8, #1
+  b.ne  _CupidGreen
+  dsb   sy
+  mrs   x10, cntfrq_el0
+  mov   x11, #3
+  mul   x10, x10, x11
+  mrs   x11, cntvct_el0
+  add   x10, x10, x11
+_CupidWait:
+  mrs   x11, cntvct_el0
+  cmp   x11, x10
+  b.lo  _CupidWait
+#endif
 
 _Entry:
   br    x5
