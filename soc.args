# soc.args: the modem and IPA SoC addresses of the Xiaomi 12 (cupid), from its own device tree.
# Generated by tools/soc-args-cupid.py; do not edit by hand. The common repository's tools/soc-args.py
# finds most of these but matches the reserved-memory nodes by the first phone's names, so it misses
# aop_cmd_db_region, mpss_region and ipa_gsi_region here.
#
modem_ipa_fw_at=0x8b910000
soc_aoss=0xc300000
soc_apps_smmu=0x15000000
soc_cmd_db=0x80860000
soc_gsi_base=0x3e04000
soc_imem=0x14600000
soc_ipa_base=0x3e40000
soc_ipa_fw=ipa_fws
soc_ipa_stream=0x5c0
soc_ipa_stream_uc=0x5c2
soc_ipcc=0xed18000
soc_mpss_mem=0x8bc00000
soc_pas_ipa=0xf
soc_rsc=0x17a20000
soc_smem=0x80900000
#
# where each value came from:
#   modem_ipa_fw_at    /reserved-memory/ipa_gsi_region@8b910000 (where the IPA's firmware is loaded)
#   soc_aoss           /soc/power-controller@c300000
#   soc_apps_smmu      /soc/apps-smmu@15000000
#   soc_cmd_db         /reserved-memory/aop_cmd_db_region@80860000 (the command DB)
#   soc_gsi_base       /soc/qcom,ipa@3e00000 (second range)
#   soc_imem           /soc/qcom,msm-imem@146aa000
#   soc_ipa_base       /soc/qcom,ipa@3e00000 + 0x40000
#   soc_ipa_fw         /soc/qcom,ipa_fws (qcom,firmware-name)
#   soc_ipa_stream     /soc/qcom,ipa@3e00000/ipa_smmu_ap (iommus)
#   soc_ipa_stream_uc  /soc/qcom,ipa@3e00000/ipa_smmu_uc (iommus)
#   soc_ipcc           /soc/qcom,ipcc@ed18000
#   soc_mpss_mem       /reserved-memory/mpss_region@8bc00000 (the modem's memory)
#   soc_pas_ipa        /soc/qcom,ipa_fws (qcom,pas-id)
#   soc_rsc            /soc/rsc@17a00000 (drv-2)
#   soc_smem           /reserved-memory/smem_region@80900000
