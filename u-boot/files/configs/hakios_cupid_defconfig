# HakiOS's U-Boot for the Xiaomi 12 (cupid, SM8450): started by ABL from RAM, never flashed.
# The phone's own device tree is supplied with EXT_DTB at build time (uefi/files/Resources/DTBs/cupid.dtb).
#include "qcom_defconfig"

CONFIG_ARM=y
# u-boot.bin carries the arm64 Linux image header ABL starts like a kernel (tools/mkuboot-cupid.py checks it).
CONFIG_LINUX_KERNEL_IMAGE_HEADER=y
# The phone's own DTB is ~780 KiB; the default 1.5 MiB offset fails init_sp_bss_offset_check.
CONFIG_SYS_INIT_SP_BSS_OFFSET=0x600000
CONFIG_DEFAULT_DEVICE_TREE="qcom/sm8450-xiaomi-cupid"
CONFIG_ENV_DEFAULT_ENV_TEXT_FILE="board/qualcomm/hakios-cupid.env"
# The console on the framebuffer ABL left live (simple-framebuffer in the device tree):
# a running U-Boot without it writes nothing to the panel.
CONFIG_VIDEO=y
CONFIG_VIDEO_SIMPLE=y
CONFIG_CMD_HAKIOS=y
CONFIG_EFI_QCOM_USB_DEVICE=y

CONFIG_PANIC_HANG=y
CONFIG_CMD_PAUSE=y
CONFIG_BOOT_RETRY=y
CONFIG_BOOT_RETRY_TIME=1
CONFIG_BUTTON_REMAP_PHONE_KEYS=y
CONFIG_RETRY_BOOTCMD=y
CONFIG_USB_FUNCTION_FASTBOOT=y
CONFIG_USB_FUNCTION_ACM=y
CONFIG_CMD_UMS_ABORT_KEYED=y
CONFIG_CONSOLE_RECORD=y
CONFIG_CONSOLE_RECORD_INIT_F=y
CONFIG_CONSOLE_RECORD_OUT_SIZE=0x6000
CONFIG_FASTBOOT_CMD_OEM_CONSOLE=y
CONFIG_FASTBOOT_OEM_RUN=y
# CONFIG_REQUIRE_SERIAL_CONSOLE is not set

CONFIG_FASTBOOT_BUF_SIZE=0x8000000

# CONFIG_WATCHDOG_AUTOSTART is not set
# CONFIG_EFI_RUNTIME_UPDATE_CAPSULE is not set
# CONFIG_EFI_CAPSULE_ON_DISK is not set
# CONFIG_EFI_CAPSULE_FIRMWARE_RAW is not set
# CONFIG_TOOLS_MKEFICAPSULE is not set
